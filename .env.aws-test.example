# Public preparation template; do not overwrite the existing AWS .env.
# Existing cloud project/database retain their identity; never reuse for production.
POSTGRES_PASSWORD=
JWT_SECRET=
COMPOSE_PROJECT_NAME=vistrah-cloud
APP_ENV=development
COOKIE_SECURE=true
SEED_CATALOGUE=false
PUBLIC_APP_URL=https://vistrah.in
PUBLIC_API_URL=https://api.vistrah.in
ALLOWED_ORIGINS=https://vistrah.in
ADMIN_ALLOWED_ORIGINS=https://admin.vistrah.in
V_ADS_PRIVATE_VOLUME=
V_ADS_MEDIA_ENABLED=0
