# Copy to .env.test only for a separate disposable Compose project: vistrah-test.
# These values must never be applied to the normal vistrah20 project.
POSTGRES_USER=vistrah_test
POSTGRES_PASSWORD=vistrah-test-only
POSTGRES_DB=vistrah_test
WEB_PORT=3111
API_PORT=8111
ADMIN_PORT=3211
APP_ENV=development
COOKIE_SECURE=false
JWT_SECRET=
SEED_CATALOGUE=true
SOURCE_NETWORK_ENABLED=false
REMOTIVE_ENABLED=false
ADZUNA_ACCESS_CONFIRMED=false
PUBLIC_APP_URL=http://localhost:3111
ALLOWED_ORIGINS=http://localhost:3111,http://127.0.0.1:3111
ADMIN_ALLOWED_ORIGINS=http://localhost:3211,http://127.0.0.1:3211
