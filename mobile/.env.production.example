# Public endpoints/keys only. EXPO_PUBLIC values are included in the app bundle.
# API deployment and genuine production entitlement are separate launch gates.
# Do not set EXPO_PUBLIC_WEB_SESSION_MODE for a native APK.
# Fail closed until separate live origins are approved and configured in EAS production.
# Current vistrah.in/API/admin origins belong to AWS testing, not production.
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_API_URL=
# Public website origin is required for native V Ads share links; template only.
EXPO_PUBLIC_WEB_URL=
EXPO_PUBLIC_ADMIN_URL=
EXPO_PUBLIC_MAPTILER_API_KEY=
EXPO_PUBLIC_MAPTILER_WEB_API_KEY=
