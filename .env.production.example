# Environment template only. This is NOT authorization or a ready production deployment.
# Copy privately to .env.production; never commit actual passwords/keys.
# Production runtime/release configuration arrives in Phase 7.
# Live payments and production membership access must be implemented in Phase 5.
POSTGRES_USER=vistrah
POSTGRES_PASSWORD=
POSTGRES_DB=vistrah_production
COMPOSE_PROJECT_NAME=vistrah-production
WEB_PORT=3120
API_PORT=8120
ADMIN_PORT=3220
APP_ENV=production
COOKIE_SECURE=true
JWT_SECRET=
SEED_CATALOGUE=false
SOURCE_NETWORK_ENABLED=false
REMOTIVE_ENABLED=false
ADZUNA_ACCESS_CONFIRMED=false
# Separate approved live origins; existing vistrah.in hosts are AWS testing.
PUBLIC_APP_URL=
PUBLIC_API_URL=
ALLOWED_ORIGINS=
ADMIN_ALLOWED_ORIGINS=
PRODUCTION_API_IMAGE=
PRODUCTION_WORKER_IMAGE=
PRODUCTION_WEB_IMAGE=
PRODUCTION_ADMIN_IMAGE=
PRODUCTION_DB_VOLUME=
PRODUCTION_API_VOLUME=
V_ADS_PRIVATE_VOLUME=
V_ADS_MEDIA_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=VISTRAH
SMTP_USERNAME=
SMTP_PASSWORD=
