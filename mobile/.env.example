# Android emulator: use 10.0.2.2. Physical phone: use your reachable development API.
# Never put secrets in EXPO_PUBLIC variables; they are bundled into the app.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8100
EXPO_PUBLIC_WEB_URL=http://10.0.2.2:3100
# Only the independent admin dashboard opens on the web.
EXPO_PUBLIC_ADMIN_URL=http://10.0.2.2:3200
# Public map keys: use separate native and browser keys with provider restrictions.
EXPO_PUBLIC_MAPTILER_API_KEY=
EXPO_PUBLIC_MAPTILER_WEB_API_KEY=


# Public OAuth client IDs; register Android package/signing SHA and iOS bundle separately.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# iOS reverse client ID URL scheme for the native config plugin.
GOOGLE_IOS_URL_SCHEME=
