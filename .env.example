# Compose has local-only database defaults. Change these before any shared deployment.
POSTGRES_USER=vistrah
POSTGRES_PASSWORD=vistrah-local-only
POSTGRES_DB=vistrah
WEB_PORT=3000
API_PORT=8000
# Set a random value of at least 32 characters for any non-local deployment.
# If omitted locally, the backend generates and persists a secret in its data volume.
JWT_SECRET=
SEED_CATALOGUE=true
SOURCE_NETWORK_ENABLED=true
REMOTIVE_ENABLED=true
# Optional Adzuna UK API; enable in Admin > Job Sources after configuration.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Set true only after verifying that Adzuna permits your intended use.
ADZUNA_ACCESS_CONFIRMED=false
COOKIE_SECURE=false
APP_ENV=development
# Set to the actual HTTPS website URL for production; local example only.
PUBLIC_APP_URL=http://localhost:3000
# Email recovery is disabled until all SMTP credentials/sender are configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=VISTRAH
SMTP_USE_TLS=true
# starttls on 587, or ssl for implicit TLS on 465. Plaintext SMTP is unsupported.
SMTP_TLS_MODE=starttls
# For a shared deployment, set exact HTTPS frontend origins separated by commas.
# ALLOWED_ORIGINS=https://vistrah.example.com
