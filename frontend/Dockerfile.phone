FROM node:22.16.0-alpine AS builder
WORKDIR /app
COPY mobile/package.json mobile/package-lock.json ./
RUN npm ci
COPY mobile/ .
ENV EXPO_PUBLIC_WEB_SESSION_MODE=cookie
ENV EXPO_PUBLIC_API_URL=https://api.vistrah.in
ENV EXPO_PUBLIC_ADMIN_URL=https://admin.vistrah.in
ARG EXPO_PUBLIC_MAPTILER_WEB_API_KEY
ENV EXPO_PUBLIC_MAPTILER_WEB_API_KEY=$EXPO_PUBLIC_MAPTILER_WEB_API_KEY
ENV EXPO_NO_DOTENV=1 EXPO_NO_TELEMETRY=1 CI=1
RUN npx expo export --platform web --output-dir /output
FROM caddy:2.10.2-alpine
COPY --from=builder /output /srv
COPY infra/aws-test/Caddyfile.phone /etc/caddy/Caddyfile
EXPOSE 8080
